{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "!src/domain/**/*.spec.ts",
    "!src/application/**/*.spec.ts",
    "!src/application/test/**"
  ],
  "reporters": ["progress", "clear-text", "html"],
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 80
  },
  "vitest": {
    "configFile": "vitest.config.mts"
  }
}
