# Copiez ce fichier en .env (jamais commite) et completez les valeurs.

# Optionnel - email du compte admin initial (bootstrap si la table users est vide)
ADMIN_EMAIL=

# Optionnel - URL publique de ce service (liens magiques, audience JWT, avatars)
AUTH_BASE_URL=http://localhost:3000

# Optionnel - URL du frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Optionnel - cle API Resend pour l'envoi des liens magiques
RESEND_API_KEY=

# Optionnel - adresse expediteur des emails
EMAIL_FROM=Auth Service <onboarding@resend.dev>

# Optionnel - paire de cles RS256 (PEM) pour signer les JWT/JWKS.
# Si absentes, une paire est generee une fois et persistee a cote de la base SQLite.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optionnel - chemin du fichier SQLite
DATABASE_PATH=

# Optionnel
NODE_ENV=development
PORT=3000

# Optionnel - replication Litestream de la DB SQLite + stockage des avatars vers MinIO (S3-compatible)
# Si MINIO_BUCKET est defini, le conteneur restaure la DB au demarrage et la
# replique en continu ; les avatars sont stockes dans le meme bucket.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REPLICA_PATH=auth-db/dev
AVATARS_PREFIX=auth-avatars/dev
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
