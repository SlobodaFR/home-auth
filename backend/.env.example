# Copiez ce fichier en .env (jamais commite) et completez les valeurs.

# Optionnel - email du compte admin initial (bootstrap si la table users est vide)
ADMIN_EMAIL=

# Optionnel - URL publique de ce service (liens magiques, avatars, claim iss des access tokens).
# Une origine, sans chemin : sinon le service refuse de demarrer.
AUTH_BASE_URL=http://localhost:3000

# URL du SPA : redirections /login et /error. CORS n'est ouvert qu'a cette origine, et seulement
# si elle differe de AUTH_BASE_URL (dev avec Vite). Obligatoire en production, en https,
# comme AUTH_BASE_URL : sinon le service refuse de demarrer.
FRONTEND_URL=http://localhost:5173

# Optionnel - cle API Resend pour l'envoi des liens magiques
RESEND_API_KEY=

# Obligatoire en production - secret des pseudonymes (logs sans email, identifiants de telemetrie).
# Au moins 32 octets : openssl rand -hex 32. Le changer re-cle tous les pseudonymes.
# Absent hors production : une valeur de developpement est utilisee.
PSEUDONYM_SECRET=

# Optionnel - telemetrie anonyme PostHog (aucun email, IP ni token). Absente : desactivee.
POSTHOG_API_KEY=
# Optionnel - hote PostHog (par defaut le cloud EU : https://eu.i.posthog.com)
POSTHOG_HOST=

# Optionnel - feature flags home-features (OFREP). Absentes ou invalides : flags desactives,
# le defaut du code s'applique (le demarrage n'est jamais bloque). URL en https en production ;
# cle d'API serveur liee a l'app et a l'environnement (hf_ + 64 hex).
FEATURES_OFREP_URL=
FEATURES_API_KEY=
# Pin d'urgence d'un flag, prioritaire sur home-features : FEATURES_PIN_<CLE_EN_MAJ_SNAKE>=true|false
# ex. FEATURES_PIN_AUTH_REFRESH_REUSE_REVOCATION=false

# Optionnel - adresse expediteur des emails
EMAIL_FROM=Auth Service <onboarding@resend.dev>

# Optionnel - paire de cles RS256 pour signer les JWT/JWKS. Les deux cles ensemble ou aucune.
# Recommande (une seule ligne, sans retour a la ligne) : le PEM encode en base64.
#   base64 < jwt-private.pem | tr -d '\n'
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
# Alternative : PEM brut, ou PEM avec des \n litteraux (ne pas combiner avec les *_B64).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Si absentes, une paire est generee une fois et persistee a cote de la base SQLite.
# Si presentes ET si jwt-private.pem / jwt-public.pem existent dans le volume, ce doit etre la
# meme paire (empreinte SHA-256 de la cle publique), sinon le service refuse de demarrer.
